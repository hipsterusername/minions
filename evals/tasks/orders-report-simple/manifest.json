{
  "schemaVersion": 1,
  "id": "orders-report-simple",
  "revision": "r2",
  "family": "cli",
  "difficulty": "simple",
  "promptFile": "prompt.md",
  "fixture": {
    "builderId": "fixture.orders-report",
    "configFile": "fixture.mjs",
    "imageDigest": "node:22-alpine"
  },
  "requiredCapabilities": [
    "filesystem",
    "process"
  ],
  "submission": {
    "include": [
      "src/**"
    ],
    "exclude": [
      "node_modules/**"
    ],
    "maxBytes": 65536
  },
  "criteria": [
    {
      "id": "orders.parse",
      "description": "Validate the documented unquoted CSV dialect, Gregorian timestamps, IDs and exact decimal amounts; skip invalid data rows.",
      "mandatory": true
    },
    {
      "id": "orders.deduplicate",
      "description": "Last valid row for an order ID wins.",
      "mandatory": true
    },
    {
      "id": "orders.totals",
      "description": "Emit UTC monthly decimal totals in sorted order.",
      "mandatory": true
    },
    {
      "id": "orders.exit",
      "description": "Use documented success and usage exit codes.",
      "mandatory": true
    }
  ],
  "grader": {
    "id": "grader.orders-report",
    "revision": "r2",
    "configFile": "../../ground-truth/orders-report-simple/oracle.mjs"
  },
  "limits": {
    "maxTotalTokens": 4000,
    "executionTimeoutMs": 300000,
    "preparationTimeoutMs": 60000,
    "gradingTimeoutMs": 60000
  }
}
