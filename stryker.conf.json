{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing is a periodic maintenance check, not a CI gate.",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["progress", "clear-text", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "mutate": [
    "src/canvas-state.ts",
    "src/graph-runtime.ts"
  ],
  "concurrency": 4,
  "timeoutMS": 30000,
  "ignorePatterns": [
    ".canvas-worktrees",
    "dist",
    "build",
    "reports"
  ]
}
