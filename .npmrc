# ── Supply-chain hardening ──────────────────────────────────────────────
# Every flag below is a deliberate guardrail, not a style preference.
# If you remove one, leave a comment explaining why.

# Fail fast on missing peer deps instead of silently shimming them.
# Catches the "this dep needs React 18 but I'm on 19" class of bug at install.
strict-peer-dependencies=true

# Stop minor-version drift. With this on, `pnpm add foo` writes `1.2.3`
# rather than `^1.2.3`, so lockfile-less installs (the rare case) still
# get a single concrete version. The lockfile remains the source of truth.
save-exact=true

# Build cache for pkgs allowed to run lifecycle scripts is per-package, not
# global, so a compromised `postinstall` can't poison unrelated installs.
# (pnpm 9+ default; setting explicitly to survive future flips.)
side-effects-cache=false

# Audit gate: fail `pnpm install` if a runtime dep has a high+ severity CVE.
# Adjust to `moderate` once the noise floor is known.
audit-level=high

# Provenance display in `pnpm list --long`. Doesn't enforce anything, but
# surfaces packages published with sigstore attestations during review.
verify-store-integrity=true
