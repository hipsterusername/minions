{"message":{"type":"sdk_event","sessionKey":"leader-1","event":{"kind":"tool_call","id":"toolu_03","name":"mcp__task-manager__plan_task","input":{"taskId":"task-b","title":"Second task","description":"Do the second thing","priority":"medium"}}}}
{"message":{"type":"sdk_event","sessionKey":"leader-1","event":{"kind":"tool_call","id":"toolu_04","name":"mcp__task-manager__assign_task","input":{"taskId":"task-a","prompt":"Do the first thing"}}}}
{"message":{"type":"session_status","sessionKey":"minion-task-a","status":"running","sessionId":"minion-sess-001"}}
