# Synthetic SDK message stream — Leader: plan-and-delegate scenario.
# Phase 3 format: sdk_event carries `event: NormalizedEvent` (not SdkMessage).
#
# Sequence:
#   1. init              — session boots
#   2. thinking          — leader plans
#   3. text              — leader narrates the plan
#   4. tool_call         — set_task_name (MCP)
#   5. session_task_name — server echoes the new name back over WS
#   6. tool_call         — plan_task (task-a)
#   7. tool_call         — plan_task (task-b)
#   8. tool_call         — assign_task
#   9. session_status    — minion session boots
#  10. text              — leader confirms delegation
#  11. usage             — cost accounting
#  12. done              — turn completes
{"message":{"type":"sdk_event","sessionKey":"leader-1","event":{"kind":"init","sessionId":"leader-sess-001","model":"claude-opus-4-5","permissionMode":"default"}}}
{"message":{"type":"sdk_event","sessionKey":"leader-1","event":{"kind":"thinking","text":"Two independent tasks. I'll plan both, then delegate the first to a minion."}}}
{"message":{"type":"sdk_event","sessionKey":"leader-1","event":{"kind":"text","text":"<!--task-name:Plan and delegate-->\nI'll plan the two tasks and delegate the first.","role":"assistant"}}}
{"message":{"type":"sdk_event","sessionKey":"leader-1","event":{"kind":"tool_call","id":"toolu_01","name":"mcp__task-manager__set_task_name","input":{"name":"Plan and delegate"}}}}
